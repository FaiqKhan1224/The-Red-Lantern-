{
  "name": "the-red-lantern",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "seed": "node server/src/seed.js",
    "dev": "concurrently -n server,client -c red,yellow \"node --watch server/src/index.js\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "nodemailer": "^6.9.15",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
